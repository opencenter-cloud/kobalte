{
	"name": "@opencenter-cloud/kobalte-vanilla-extract",
	"version": "0.1.2",
	"private": false,
	"description": "Vanilla Extract utilities for styling Kobalte components. Solid 2 bridge fork of @kobalte/vanilla-extract, published by opencenter-cloud.",
	"keywords": [
		"solid",
		"solidjs",
		"solid-2",
		"ui",
		"library",
		"design-system",
		"components",
		"vanilla-extract",
		"kobalte-fork"
	],
	"homepage": "https://github.com/opencenter-cloud/kobalte/tree/feat/corvu-next-integration/packages/vanilla-extract#readme",
	"bugs": {
		"url": "https://github.com/opencenter-cloud/kobalte/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/opencenter-cloud/kobalte.git"
	},
	"license": "MIT",
	"author": "Fabien Marie-Louise <fabienml.dev@gmail.com>",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs",
			"require": "./dist/index.js",
			"node": "./dist/index.js"
		},
		"./src/*": "./src/*"
	},
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"source": "src/index.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@vanilla-extract/css": "^1.21.1"
	},
	"peerDependencies": {
		"@vanilla-extract/css": "^1.13.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
