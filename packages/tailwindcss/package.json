{
	"name": "@opencenter-cloud/kobalte-tailwindcss",
	"version": "0.1.0",
	"private": false,
	"description": "TailwindCSS plugin for styling Kobalte components with data-* attributes (ui-expanded:*, etc.). Solid 2 bridge fork of @kobalte/tailwindcss, published by opencenter-cloud.",
	"keywords": [
		"solid",
		"solidjs",
		"solid-2",
		"ui",
		"library",
		"design-system",
		"components",
		"tailwindcss",
		"kobalte-fork"
	],
	"homepage": "https://github.com/opencenter-cloud/kobalte/tree/feat/corvu-next-integration/packages/tailwindcss#readme",
	"bugs": {
		"url": "https://github.com/opencenter-cloud/kobalte/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/opencenter-cloud/kobalte.git"
	},
	"license": "MIT",
	"author": "Fabien Marie-Louise <fabienml.dev@gmail.com>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": "./dist/index.cjs"
		},
		"./src/*": "./src/*"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "src/index.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"tailwindcss": "^4.3.2"
	},
	"peerDependencies": {
		"tailwindcss": ">=3"
	},
	"publishConfig": {
		"access": "public"
	}
}
